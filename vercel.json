{
  "version": 2,
  "builds": [
    {
      "src": "api/verify_key.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/interceptor.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/create_key.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/verify_key",
      "dest": "/api/verify_key.py"
    },
    {
      "src": "/api/interceptor",
      "dest": "/api/interceptor.py"
    },
    {
      "src": "/api/create_key",
      "dest": "/api/create_key.py"
    }
  ]
}
